{
  "name": "caffeinate-macos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "bun test",
    "verify:contract": "node scripts/verify-contract.mjs",
    "check": "bun run test && bun run build && bun run verify:contract",
    "tauri": "tauri",
    "tauri:dev": "bun tauri dev",
    "tauri:build": "bun tauri build --bundles app,dmg"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}

{
  "name": "caffeinate-macos",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "bun@1.4.0-canary.1+032b8dbf1",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:focus": "node scripts/check-focused-tests.mjs",
    "verify:contract": "node scripts/verify-contract.mjs",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run test:focus && bun run coverage && bun run build && bun run verify:contract",
    "clean": "rm -rf dist coverage src-tauri/target",
    "tauri": "tauri",
    "tauri:dev": "bun tauri dev",
    "tauri:build": "bun tauri build --bundles app,dmg --target universal-apple-darwin"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "svelte": "5.56.9"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "eslint-plugin-svelte": "3.23.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}

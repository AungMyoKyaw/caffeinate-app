{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caffeinate",
  "version": "1.0.0",
  "identifier": "ai.learningflow.caffeinate",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Caffeinate",
        "width": 720,
        "height": 560,
        "minWidth": 620,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Utility",
    "shortDescription": "Keep your Mac awake with the built-in caffeinate command.",
    "longDescription": "A small local macOS utility that starts and owns the built-in caffeinate command, with optional display and duration controls.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
